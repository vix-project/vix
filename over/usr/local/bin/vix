#!/bin/sh
set -eu

NIX=/nix/var/nix/profiles/default/bin/nix
[ -x "$NIX" ] || NIX="$(command -v nix)"
state=/var/lib/vix

usage() {
  cat <<'EOF'
vix - declarative services and kernels on a running Vix machine

  vix init [DIR]        create a machine flake (default: /etc/vix)
  vix build [FLAKE#HOST] build a declared system as ./result
  vix switch [FLAKE#HOST] build and apply it on this running machine
  vix status            show declared service status
  vix generations       list saved generations
  vix rollback [N]      activate generation N (default: previous)
  vix recover           recover an interrupted activation

The default configuration is /etc/vix#default.
Declare services.runit, boot.kernelPackages, boot.extraModulePackages and
hardware.firmware in the machine flake. New kernels take effect at reboot.
For regular packages use nix profile add nixpkgs#htop.
EOF
  exit "${1:-1}"
}

require_vix() {
  if [ ! -r /etc/os-release ] || ! grep -Eq '^ID="?vix"?$' /etc/os-release || [ "$(cat /proc/1/comm)" != runit ]; then
    echo 'vix: this command requires an already booted Vix system' >&2
    exit 1
  fi
}

build_system() {
  reference="${1:-/etc/vix#default}"
  case "$reference" in
    *'#'*) flake="${reference%%#*}"; host="${reference#*#}" ;;
    *) flake="$reference"; host=default ;;
  esac
  [ -n "$flake" ] || flake=.
  if ! printf '%s\n' "$host" | grep -Eq '^[a-zA-Z0-9_-]+$'; then
    echo 'vix: select a host as FLAKE#HOST (letters, digits, underscores and hyphens)' >&2
    exit 1
  fi
  if [ "$flake" = /etc/vix ] && [ ! -f /etc/vix/flake.nix ]; then
    echo 'vix: no machine flake; run vix init and edit /etc/vix/flake.nix' >&2
    exit 1
  fi
  "$NIX" build "$flake#vixConfigurations.\"$host\".config.system.build.toplevel" \
    --out-link "$2" --print-out-paths
}

interrupt_switch() {
  if [ -n "${activation_pid:-}" ]; then
    kill -TERM "$activation_pid" 2>/dev/null || true
    wait "$activation_pid" || true
  fi
  exit "$1"
}

cmd="${1:-}"
[ -n "$cmd" ] || usage
shift || true
case "$cmd" in --help|-h|help) usage 0 ;; esac
case "$cmd" in
  build) ;;
  *) [ "$(id -u)" -eq 0 ] || { echo 'vix: must be root' >&2; exit 1; } ;;
esac

case "$cmd" in
  init)
    [ $# -le 1 ] || usage
    require_vix
    directory="${1:-/etc/vix}"
    if [ -e "$directory/flake.nix" ] || [ -L "$directory/flake.nix" ]; then
      echo "vix: keeping existing machine flake: $directory/flake.nix" >&2
      exit 1
    fi
    source="${VIX_FLAKE_URL:-github:vix-project/vix}"
    if ! printf '%s\n' "$source" | grep -Eq '^[a-zA-Z0-9_./:+?=&%~@#-]+$'; then
      echo 'vix: invalid VIX_FLAKE_URL' >&2
      exit 1
    fi
    uuid="$(findmnt -n -o UUID /)"
    root_device=/dev/ROOT
    [ -z "$uuid" ] || root_device="UUID=$uuid"
    mkdir -p "$directory"
    (
      set -C
      cat > "$directory/flake.nix" <<EOF
{
  inputs.vix.url = "$source";

  outputs = { vix, ... }: {
    vixConfigurations.default = vix.lib.vixSystem {
      system = "x86_64-linux";
      modules = [ ({ pkgs, config, ... }: {
        boot.rootDevice = "$root_device";
        # Opt in to generation-based GRUB boot management:
        # boot.kernel.enable = true;
        # boot.kernelPackages = pkgs.linuxPackages;
        # boot.extraModulePackages = [ config.boot.kernelPackages.v4l2loopback ];
        # hardware.firmware = [ pkgs.linux-firmware pkgs.wireless-regdb ];

        services.runit = {
          # example = {
          #   enable = true;
          #   run = "exec \${pkgs.coreutils}/bin/sleep infinity";
          #   log.enable = true;
          # };
        };
      }) ];
    };
  };
}
EOF
    )
    echo "vix: created $directory/flake.nix; edit it, then run vix switch $directory#default"
    ;;
  build)
    [ $# -le 1 ] || usage
    build_system "${1:-/etc/vix#default}" "$(pwd)/result"
    ;;
  switch)
    [ $# -le 1 ] || usage
    require_vix
    mkdir -p "$state"
    temporary="$(mktemp -d "$state/build.XXXXXX")"
    trap 'rm -rf "$temporary"' EXIT
    trap 'interrupt_switch 130' INT
    trap 'interrupt_switch 143' TERM
    system="$(build_system "${1:-/etc/vix#default}" "$temporary/result")"
    "$system/bin/vix-activate" switch "$system" &
    activation_pid=$!
    wait "$activation_pid"
    ;;
  status|generations|rollback|recover|boot)
    require_vix
    driver="$state/current/bin/vix-activate"
    if [ "$cmd" = recover ] && [ -e "$state/pending/bin/vix-activate" ]; then
      driver="$state/pending/bin/vix-activate"
    fi
    if [ ! -e "$driver" ]; then
      case "$cmd" in
        status) echo 'vix: no active declared services'; exit 0 ;;
        generations) echo 'vix: no saved generations'; exit 0 ;;
        recover)
          [ ! -f "$state/transaction.json" ] || { echo 'vix: recovery driver is missing' >&2; exit 1; }
          exit 0 ;;
        *) echo 'vix: no saved generations' >&2; exit 1 ;;
      esac
    fi
    exec "$driver" "$cmd" "$@"
    ;;
  kernel|kmod|firmware)
    echo "vix: $cmd is declarative now; edit boot.kernelPackages, boot.extraModulePackages or hardware.firmware in your machine flake, then run vix switch" >&2
    exit 1
    ;;
  *) usage ;;
esac
